{
  "name": "abap2ui5-selection-screen",
  "private": true,
  "version": "1.0.0",
  "description": "Selection-Screens, Ranges, Filter and Variant Management for abap2UI5.",
  "scripts": {
    "syfixes": "find . -type f -name '*.abap' -exec sed -i -e 's/ RAISE EXCEPTION TYPE cx_sy_itab_line_not_found/ ASSERT 1 = 0/g' {} + ",
    "rename": "abaplint .github/abaplint/rename.json --rename",
    "lint": "abaplint ./abaplint.jsonc",
    "check:cloud": "abaplint .github/abaplint/abap_cloud.jsonc",
    "check:abap2ui5": "abap2ui5lint",
    "check": "npm run lint && npm run check:cloud && npm run check:abap2ui5 && npm run rename",
    "test": "npm run check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abap2UI5-addons/selection-screen.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/abap2UI5-addons/selection-screen/issues"
  },
  "homepage": "https://github.com/abap2UI5-addons/selection-screen#readme",
  "devDependencies": {
    "@abaplint/cli": "^2.120.35",
    "@abaplint/database-sqlite": "^2.13.40",
    "@abaplint/runtime": "^2.13.60",
    "@abaplint/transpiler-cli": "^2.13.60",
    "@types/node": "^26.2.0",
    "npm-check-updates": "^23.1.0",
    "@abap2ui5/linter": "^0.3.0",
    "@abap2ui5/render-runtime": "^0.3.0"
  },
  "engines": {
    "node": ">=22"
  }
}
